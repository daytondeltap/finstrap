<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.AccountSignInDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                  Title="Roblox account sign-in" Width="800" Height="690"
                  WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                  Loaded="OnLoaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Opening Roblox sign-in…" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:Button x:Name="ContinueButton" Grid.Column="1" Content="Continue" IsEnabled="False" Click="Continue_Click" />
        </Grid>
        <web:WebView2 x:Name="Browser" />
    </DockPanel>
</base:WpfUiWindow>
