<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.LaunchMenuDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Finstrap · Accounts" Width="1020" Height="760" MinWidth="850" MinHeight="600"
 Background="{ui:ThemeResource ApplicationBackgroundBrush}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
 ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <ui:TitleBar x:Name="RootTitleBar" DockPanel.Dock="Top" Padding="8" Title="Finstrap · Accounts"
               Background="{ui:ThemeResource ApplicationBackgroundBrush}"
               Icon="pack://application:,,,/Bloxstrap.ico" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <Border x:Name="DashboardSurface" Background="{ui:ThemeResource ApplicationBackgroundBrush}" Padding="24">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <Grid x:Name="AccountSessionHost" Height="1" Opacity="0" IsHitTestVisible="False" Focusable="False"/>
      <TextBlock Text="Your Roblox accounts" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Launch together. Keep track of every session." Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,16"/>
      <WrapPanel>
       <ui:Button Content="Settings" Command="{Binding LaunchSettingsCommand}" Margin="0,0,8,8"/>
       <ui:Button Content="Roblox Studio" Command="{Binding LaunchRobloxStudioCommand}" Margin="0,0,8,8"/>
       <ui:Button Content="Launch Roblox" Click="LaunchDefault_Click" Margin="0,0,8,8"/>
       <ui:Button Content="Find a game" Click="FindGame_Click" Margin="0,0,8,8"/>
       <ui:Button Content="Export diagnostics" Click="ExportDiagnostics_Click" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <WrapPanel Margin="0,8,0,0">
       <ui:Button Content="Cancel remaining" Click="CancelRemaining_Click" Margin="0,0,8,0"/>
       <ui:Button Content="Retry failed" Click="RetryFailed_Click" Margin="0,0,8,0"/>
       <ui:Button Content="Tile windows" Click="Tile_Click" Margin="0,0,8,0"/>
       <ui:Button Content="Save layout" Click="SaveLayout_Click" Margin="0,0,8,0"/>
       <ui:Button Content="Restore layout" Click="RestoreLayout_Click"/>
      </WrapPanel>
     </StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,20,0">
       <Border x:Name="GameFinder" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12" CornerRadius="8"
               Margin="0,0,0,12" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
         <TextBlock Text="Find a Roblox game" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock x:Name="GameFinderHint" TextWrapping="Wrap" Margin="0,4,0,8"/>
         <DockPanel>
          <ui:Button x:Name="SearchGamesButton" DockPanel.Dock="Right" Content="Search" Click="SearchGames_Click" Margin="8,0,0,0"/>
          <ui:TextBox x:Name="GameQuery" PlaceholderText="Game name, place ID, or public server link"
                      AutomationProperties.Name="Roblox game search" KeyDown="GameQuery_KeyDown"/>
         </DockPanel>
         <ListBox x:Name="GameResults" DisplayMemberPath="Name" MaxHeight="156" Margin="0,8,0,0"
                  AutomationProperties.Name="Roblox search results" SelectionChanged="GameResults_SelectionChanged"
                  MouseDoubleClick="GameResults_DoubleClick"/>
         <WrapPanel Margin="0,8,0,0">
          <ui:Button x:Name="UseGame" Content="Use selected game" Click="UseGame_Click" IsEnabled="False" Margin="0,0,8,0"/>
          <ui:Button Content="Close game finder" Click="CloseGameFinder_Click"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <TextBlock x:Name="AccountHint" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <ListBox x:Name="AccountsList" SelectionChanged="AccountsSelectionChanged" AutomationProperties.Name="Accounts">
        <ListBox.ItemTemplate><DataTemplate>
         <Border Padding="12" Margin="0,2" CornerRadius="8"
                 Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                 BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Image Source="{Binding Avatar}" Width="44" Height="44"/>
           <StackPanel Grid.Column="1">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
            <TextBlock Text="{Binding Detail}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4"/>
            <WrapPanel>
             <ui:Button Content="Launch" Click="LaunchCard_Click" Margin="0,0,6,0"/>
             <ui:Button Content="Rejoin last public server" Click="RejoinCard_Click" Margin="0,0,6,0"/>
             <ui:Button Content="Focus" Click="FocusCard_Click" Margin="0,0,6,0"/>
             <ui:Button Content="Reconnect" Click="ReconnectCard_Click" Margin="0,0,6,0"/>
             <ui:Button Content="Close game" Click="CloseCard_Click" Margin="0,0,6,0"/>
             <ui:Button Content="Remove" Click="RemoveCard_Click"/>
            </WrapPanel>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
      <StackPanel x:Name="LaunchActions" Grid.Column="1">
       <WrapPanel Margin="0,0,0,16">
        <ui:Button Content="Add account" Click="AddAccount_Click" Margin="0,0,8,0"/>
        <ui:Button Content="Add and launch" Click="AddAndLaunch_Click"/>
       </WrapPanel>
       <TextBlock Text="Launch groups" FontSize="18" FontWeight="SemiBold"/>
       <ComboBox x:Name="Groups" SelectionChanged="GroupChanged" Margin="0,8"/>
       <ui:TextBox x:Name="GroupName" PlaceholderText="Group name" Margin="0,0,0,8"/>
       <ui:TextBox x:Name="GroupChannel" PlaceholderText="Group channel (optional)" AutomationProperties.Name="Group channel" Margin="0,0,0,8"/>
       <WrapPanel><ui:Button Content="Save selected as group" Click="SaveGroup_Click"/><ui:Button Content="Delete" Click="DeleteGroup_Click" Margin="4,0,0,0"/></WrapPanel>
       <ui:Button Content="Preview and launch group" Click="LaunchGroup_Click" Margin="0,8,0,0"/>
       <TextBlock Text="Select accounts in launch order. Use ↑ / ↓ to adjust the selected account." TextWrapping="Wrap" Margin="0,8"/>
       <WrapPanel><ui:Button Content="↑" Click="MoveUp_Click"/><ui:Button Content="↓" Click="MoveDown_Click" Margin="8,0"/></WrapPanel>
       <TextBlock Text="Destination" Margin="0,16,0,4"/>
       <ui:TextBox x:Name="AccountDestination" PlaceholderText="Place ID, server link, or friend"/>
       <TextBlock Text="Blank uses saved places. With a country selected, 0 opens Finstrap’s game finder. Any region lets 0 open Roblox Home." TextWrapping="Wrap" Margin="0,4,0,12"/>
       <TextBlock Text="Server country" Margin="0,0,0,4"/>
       <ComboBox x:Name="ServerCountry" DisplayMemberPath="Name" SelectedValuePath="Code"
                 SelectionChanged="ServerCountry_Changed" AutomationProperties.Name="Server country"/>
       <TextBlock Text="Applies to public games launched from Finstrap. If no match is found, the game stays closed." TextWrapping="Wrap" Margin="0,4,0,0"/>
       <ui:Button Content="Check server location" Click="CheckServerLocation_Click" Margin="0,8,0,12"/>
       <ui:Button x:Name="LaunchSelected" Appearance="Primary" Content="Play with selected accounts" Click="LaunchSelected_Click" Margin="0,0,0,8"/>
       <ui:Button x:Name="LaunchAll" Content="Play with all accounts" Click="LaunchAll_Click"/>
      </StackPanel>
     </Grid>
    </DockPanel>
   </Border>
  </ScrollViewer>
 </DockPanel>
</base:WpfUiWindow>
